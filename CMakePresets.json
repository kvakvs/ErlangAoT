{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (C++23)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "CLAUSE_BUILD_COMPILER": "ON",
        "CLAUSE_BUILD_RUNTIME": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows clang-cl (Debug/Release)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "CLAUSE_BUILD_COMPILER": "ON",
        "CLAUSE_BUILD_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "jobs": 0
    },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 0 },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-fast",
      "inherits": "debug",
      "environment": { "CLAUSE_TEST_MODE": "fast" },
      "filter": { "exclude": { "label": "full_only" } },
      "execution": { "jobs": 0 }
    },
    {
      "name": "windows-debug-fast",
      "inherits": "windows-debug",
      "environment": { "CLAUSE_TEST_MODE": "fast" },
      "filter": { "exclude": { "label": "full_only" } },
      "execution": { "jobs": 0 }
    }
  ]
}
