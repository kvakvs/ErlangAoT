# Keep nested native test builds on the parent's generator, architecture, dependencies and CRT.
set(host_configure_args -G [==[@CMAKE_GENERATOR@]==])
set(host_platform [==[@CMAKE_GENERATOR_PLATFORM@]==])
set(host_toolset [==[@CMAKE_GENERATOR_TOOLSET@]==])
if(host_platform)
    list(APPEND host_configure_args -A "${host_platform}")
endif()
if(host_toolset)
    list(APPEND host_configure_args -T "${host_toolset}")
endif()
set(host_CMAKE_MAKE_PROGRAM [==[@CMAKE_MAKE_PROGRAM@]==])
set(host_CMAKE_C_COMPILER [==[@CMAKE_C_COMPILER@]==])
set(host_CMAKE_CXX_COMPILER [==[@CMAKE_CXX_COMPILER@]==])
# A compiler aimed at another target (32-bit builds on 64-bit hosts) and its system root.
set(host_CMAKE_C_COMPILER_TARGET [==[@CMAKE_C_COMPILER_TARGET@]==])
set(host_CMAKE_CXX_COMPILER_TARGET [==[@CMAKE_CXX_COMPILER_TARGET@]==])
set(host_CMAKE_SYSROOT [==[@CMAKE_SYSROOT@]==])
set(host_CMAKE_C_FLAGS [==[@CMAKE_C_FLAGS@]==])
set(host_CMAKE_CXX_FLAGS [==[@CMAKE_CXX_FLAGS@]==])
set(host_CMAKE_EXE_LINKER_FLAGS [==[@CMAKE_EXE_LINKER_FLAGS@]==])
set(host_CMAKE_TOOLCHAIN_FILE [==[@CMAKE_TOOLCHAIN_FILE@]==])
set(host_CMAKE_GENERATOR_INSTANCE [==[@CMAKE_GENERATOR_INSTANCE@]==])
set(host_CMAKE_MSVC_RUNTIME_LIBRARY [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==])
set(host_CLAUSE_MSVC_ITERATOR_DEBUG_LEVEL [==[@CLAUSE_MSVC_ITERATOR_DEBUG_LEVEL@]==])
set(host_CLAUSE_CLANG_EXECUTABLE [==[@CLAUSE_CLANG_EXECUTABLE@]==])
set(host_CLAUSE_BOOST_ROOT [==[@CLAUSE_BOOST_INCLUDE@]==])
foreach(variable IN ITEMS CMAKE_MAKE_PROGRAM CMAKE_C_COMPILER CMAKE_CXX_COMPILER
        CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET CMAKE_SYSROOT
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS
        CMAKE_TOOLCHAIN_FILE CMAKE_GENERATOR_INSTANCE CMAKE_MSVC_RUNTIME_LIBRARY
        CLAUSE_CLANG_EXECUTABLE CLAUSE_BOOST_ROOT CLAUSE_MSVC_ITERATOR_DEBUG_LEVEL)
    if(NOT host_${variable} STREQUAL "")
        list(APPEND host_configure_args "-D${variable}=${host_${variable}}")
    endif()
endforeach()
# Nested test programs link the parent build's runtime (`include("${RUNTIME_TARGETS}")` gives
# Clause::generated_program) and, like the parent's tests, carry debug information only on request.
# Nested builds use no C++ modules either (no clang-scan-deps needed).
list(APPEND host_configure_args -DCMAKE_CXX_SCAN_FOR_MODULES=OFF)
set(host_runtime_targets [==[@PROJECT_BINARY_DIR@/ClauseRuntimeTargets.cmake]==])
list(APPEND host_configure_args "-DRUNTIME_TARGETS=${host_runtime_targets}")
set(host_test_debug_info [==[@CLAUSE_TEST_DEBUG_INFO@]==])
set(host_frontend [==[@CMAKE_CXX_COMPILER_FRONTEND_VARIANT@]==])
if(NOT host_test_debug_info)
    list(APPEND host_configure_args "-DCMAKE_MSVC_DEBUG_INFORMATION_FORMAT=")
    if(host_frontend STREQUAL "MSVC")
        list(APPEND host_configure_args "-DCMAKE_EXE_LINKER_FLAGS_DEBUG=/INCREMENTAL:NO")
    else()
        list(APPEND host_configure_args "-DCMAKE_CXX_FLAGS_DEBUG=-g0")
    endif()
endif()
list(APPEND host_configure_args "-DCMAKE_BUILD_TYPE=${HOST_CONFIG}")
list(APPEND host_configure_args "-DCMAKE_TRY_COMPILE_CONFIGURATION=${HOST_CONFIG}")
