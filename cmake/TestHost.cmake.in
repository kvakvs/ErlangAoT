# Keep nested native test builds on the parent's generator, architecture, dependencies and CRT.
set(host_configure_args -G [==[@CMAKE_GENERATOR@]==])
set(host_platform [==[@CMAKE_GENERATOR_PLATFORM@]==])
set(host_toolset [==[@CMAKE_GENERATOR_TOOLSET@]==])
if(host_platform)
    list(APPEND host_configure_args -A "${host_platform}")
endif()
if(host_toolset)
    list(APPEND host_configure_args -T "${host_toolset}")
endif()
set(host_CMAKE_MAKE_PROGRAM [==[@CMAKE_MAKE_PROGRAM@]==])
set(host_CMAKE_C_COMPILER [==[@CMAKE_C_COMPILER@]==])
set(host_CMAKE_CXX_COMPILER [==[@CMAKE_CXX_COMPILER@]==])
set(host_CMAKE_C_FLAGS [==[@CMAKE_C_FLAGS@]==])
set(host_CMAKE_CXX_FLAGS [==[@CMAKE_CXX_FLAGS@]==])
set(host_CMAKE_EXE_LINKER_FLAGS [==[@CMAKE_EXE_LINKER_FLAGS@]==])
set(host_CMAKE_TOOLCHAIN_FILE [==[@CMAKE_TOOLCHAIN_FILE@]==])
set(host_CMAKE_GENERATOR_INSTANCE [==[@CMAKE_GENERATOR_INSTANCE@]==])
set(host_CMAKE_MSVC_RUNTIME_LIBRARY [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==])
set(host_ERLANG_AOT_MSVC_ITERATOR_DEBUG_LEVEL [==[@ERLANG_AOT_MSVC_ITERATOR_DEBUG_LEVEL@]==])
set(host_ERLANG_AOT_CLANG_EXECUTABLE [==[@ERLANG_AOT_CLANG_EXECUTABLE@]==])
set(host_ERLANG_AOT_BOOST_ROOT [==[@ERLANG_AOT_BOOST_INCLUDE@]==])
foreach(variable IN ITEMS CMAKE_MAKE_PROGRAM CMAKE_C_COMPILER CMAKE_CXX_COMPILER
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS
        CMAKE_TOOLCHAIN_FILE CMAKE_GENERATOR_INSTANCE CMAKE_MSVC_RUNTIME_LIBRARY
        ERLANG_AOT_CLANG_EXECUTABLE ERLANG_AOT_BOOST_ROOT ERLANG_AOT_MSVC_ITERATOR_DEBUG_LEVEL)
    if(NOT host_${variable} STREQUAL "")
        list(APPEND host_configure_args "-D${variable}=${host_${variable}}")
    endif()
endforeach()
list(APPEND host_configure_args "-DCMAKE_BUILD_TYPE=${HOST_CONFIG}")
list(APPEND host_configure_args "-DCMAKE_TRY_COMPILE_CONFIGURATION=${HOST_CONFIG}")
