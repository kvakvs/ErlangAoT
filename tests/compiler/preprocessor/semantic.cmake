# Offline records are always available; live comparisons explicitly skip absent OTP.
file(GLOB inputs "${FIXTURES}/semantic/*.erl")
foreach(input IN LISTS inputs)
    execute_process(COMMAND "${DUMP}" "${input}" RESULT_VARIABLE result OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostics)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Preprocessor dump failed for ${input}: ${diagnostics}")
    endif()
    if(LIVE)
        if(NOT EXISTS "${ESCRIPT}")
            message("SKIP: escript is unavailable")
            return()
        endif()
        execute_process(COMMAND "${ESCRIPT}" "${HARNESS}" "${input}" RESULT_VARIABLE result OUTPUT_VARIABLE expected)
        if(result STREQUAL "77")
            message("SKIP: OTP 29.1 is required")
            return()
        endif()
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "OTP semantic oracle failed for ${input}")
        endif()
    else()
        file(READ "${input}.tokens" expected)
    endif()
    if(NOT actual STREQUAL expected)
        get_filename_component(name "${input}" NAME)
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}.actual" "${actual}")
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${name}.expected" "${expected}")
        message(FATAL_ERROR "Preprocessing differs for ${name}; see .actual/.expected files. ${diagnostics}")
    endif()
endforeach()
