  set(flags --impldebug 99)
 elseif(mode STREQUAL verbose)
  set(flags --verbose)
 elseif(mode STREQUAL parse)
  set(flags --impldebug 23 --parse-check)
 endif()
 execute_process(COMMAND "${TOOL}" ${flags} inference_user.erl inference_owner.erl WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 if(NOT result STREQUAL "0" OR NOT out STREQUAL "" OR err MATCHES "impldebug| inputs=")
  message(FATAL_ERROR "Unrequested inference output (${mode}): ${out}${err}")
 endif()
endforeach()
