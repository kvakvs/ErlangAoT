execute_process(COMMAND "${TOOL}" --impldebug 99 --impldebug 23,23 inference_user.erl inference_owner.erl WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
