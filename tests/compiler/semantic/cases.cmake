semantic_case(unused "-module(a). -export([f/0]). f() -> 1. unused() -> ok." 1 "atom expressions")
semantic_case(bignum "-module(a). f() -> 99999999999999999999999999999." 1 "bignum expressions")
semantic_case(negative_bignum "-module(a). f() -> -99999999999999999999999999999." 1 "bignum expressions")
semantic_case(nested_bad "-module(a). f() -> g(h(1), ok)." 1 "atom expressions")
file(WRITE "${semantic_work}/unsupported.hrl" "bad() -> ok.\n")
semantic_case(include_origin "-module(a). -include(\"unsupported.hrl\")." 1 "unsupported.hrl:1:.*atom expressions")

if(WORD_BYTES EQUAL 8)
    set(minimum "-576460752303423488")
    set(maximum "576460752303423487")
    set(overflow "576460752303423488")
    set(underflow "-576460752303423489")
else()
    set(minimum "-134217728")
    set(maximum "134217727")
    set(overflow "134217728")
    set(underflow "-134217729")
endif()
semantic_case(minimum "-module(a). f() -> ${minimum}." 0 "^$")
semantic_case(maximum "-module(a). f() -> ${maximum}." 0 "^$")
semantic_case(overflow "-module(a). f() -> ${overflow}." 1 "bignum expressions")
semantic_case(underflow "-module(a). f() -> ${underflow}." 1 "bignum expressions")
