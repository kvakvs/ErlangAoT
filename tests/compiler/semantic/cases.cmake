foreach(index RANGE 0 499)
 math(EXPR next "${index}+1")
 string(APPEND chain "f${index}(X) -> f${next}(X).\n")
endforeach()
string(APPEND chain "f500(X) -> X.\n")
semantic_case(long_call_chain "${chain}" 0 "^$")
