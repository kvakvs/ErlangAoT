semantic_case(tuple_value "-module(a). f() -> {}." 1 "heap expressions")
semantic_case(list_value "-module(a). f() -> []." 1 "heap expressions")
semantic_case(binary_value "-module(a). f() -> <<1>>." 1 "heap expressions")
semantic_case(map_value "-module(a). f() -> #{}." 1 "heap expressions")
semantic_case(arithmetic "-module(a). f(X) -> X+1." 1 "arithmetic")
semantic_case(unary "-module(a). f(X) -> -X." 1 "arithmetic")
