semantic_case(private_self "-module(a). f() -> a:g(). g() -> 2." 1 "not exported")
semantic_case(unknown_module "-module(a). f() -> outside:g()." 1 "unknown module outside")
semantic_case(local_cycle "-module(a). f() -> g(). g() -> f()." 1 "recursive calls.*notimpl")
semantic_case(self_cycle "-module(a). f() -> f()." 1 "recursive calls.*notimpl")
file(WRITE "${semantic_work}/client.erl" "-module(client). -export([f/0]). f() -> server:id(server:value()).")
file(WRITE "${semantic_work}/server.erl" "-module(server). -export([id/1,value/0]). id(X) -> X. value() -> 42.")
execute_process(COMMAND "${TOOL}" client.erl server.erl WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "0" OR NOT err STREQUAL "")
 message(FATAL_ERROR "Batch forward remote resolution: ${err}")
endif()
file(WRITE "${semantic_work}/server.erl" "-module(server). -export([id/1,value/0]). id(X) -> X. value() -> client:f().")
execute_process(COMMAND "${TOOL}" client.erl server.erl WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "1" OR NOT err MATCHES "recursive calls.*notimpl")
 message(FATAL_ERROR "Cross-module cycle: ${err}")
endif()
execute_process(COMMAND "${TOOL}" forward_call.erl identity.erl WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "1" OR NOT err MATCHES "duplicate module in compilation batch")
 message(FATAL_ERROR "Duplicate batch module: ${err}")
endif()
file(WRITE "${semantic_work}/isolated.toml" "schema_version = 1\n[[targets]]\nname='client'\nsources = ['client.erl']\n[[targets]]\nname='server'\nsources = ['server.erl']\n")
execute_process(COMMAND "${TOOL}" --project isolated.toml WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "1" OR NOT err MATCHES "unknown module server" OR NOT err MATCHES "unknown module client")
 message(FATAL_ERROR "Project target isolation: ${err}")
endif()
file(WRITE "${semantic_work}/server.erl" "-module(server). -export([id/1,value/0]). id(X) -> X. value() -> 42.")
file(WRITE "${semantic_work}/batch.toml" "schema_version = 1\n[[targets]]\nname='combined'\nsources = ['client.erl', 'server.erl']\n")
execute_process(COMMAND "${TOOL}" --project batch.toml WORKING_DIRECTORY "${semantic_work}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result STREQUAL "0" OR NOT out STREQUAL "" OR NOT err STREQUAL "")
 message(FATAL_ERROR "Project batch resolution: ${out}${err}")
endif()
