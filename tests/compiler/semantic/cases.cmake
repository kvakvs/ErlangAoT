semantic_case(unused "-module(a). -export([f/0]). f() -> 1. unused() -> ok." 1 "atom expressions")
semantic_case(bignum "-module(a). f() -> 99999999999999999999999999999." 1 "bignum expressions")
semantic_case(negative_bignum "-module(a). f() -> -99999999999999999999999999999." 1 "bignum expressions")
semantic_case(nested_bad "-module(a). f() -> g(h(1), ok)." 1 "atom expressions")
file(WRITE "${semantic_work}/unsupported.hrl" "bad() -> ok.\n")
semantic_case(include_origin "-module(a). -include(\"unsupported.hrl\")." 1 "unsupported.hrl:1:.*atom expressions")

if(WORD_BYTES EQUAL 8)
    set(minimum "-576460752303423488")
    set(maximum "576460752303423487")
    set(overflow "576460752303423488")
    set(underflow "-576460752303423489")
else()
    set(minimum "-134217728")
    set(maximum "134217727")
    set(overflow "134217728")
    set(underflow "-134217729")
endif()
semantic_case(minimum "-module(a). f() -> ${minimum}." 0 "^$")
semantic_case(maximum "-module(a). f() -> ${maximum}." 0 "^$")
semantic_case(overflow "-module(a). f() -> ${overflow}." 1 "bignum expressions")
semantic_case(underflow "-module(a). f() -> ${underflow}." 1 "bignum expressions")

semantic_case(feature_name "-module(a). f() -> ok." 1 "feature_name.erl:1:.*\\[atom expressions\\] notimpl")
file(WRITE "${semantic_work}/sentinel" "existing artifact")
execute_process(COMMAND "${TOOL}" -o sentinel supported_subset.erl unused.erl WORKING_DIRECTORY "${semantic_work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(READ "${semantic_work}/sentinel" sentinel)
if(NOT result STREQUAL "1" OR NOT out STREQUAL "" OR NOT err MATCHES "\\[atom expressions\\] notimpl"
    OR NOT sentinel STREQUAL "existing artifact")
    message(FATAL_ERROR "Capability failure published output or lost its feature diagnostic: ${err}")
endif()

semantic_case(identity "-module(a). f(X) -> X." 0 "^$")
semantic_case(projection "-module(a). f(_, X, _) -> (X)." 0 "^$")
semantic_case(named_underscore "-module(a). f(_X) -> _X." 0 "^$")
semantic_case(unbound "-module(a). f(X) -> Missing." 1 "unbound variable Missing")
semantic_case(wildcard_read "-module(a). f(_) -> _." 1 "wildcard '_' cannot be read")
semantic_case(repeated_parameter "-module(a). f(X,X) -> X." 1 "\\[pattern matching\\] notimpl")
semantic_case(repeated_named_underscore "-module(a). f(_X,_X) -> 1." 1 "\\[pattern matching\\] notimpl")
semantic_case(binding_scope "-module(a). f(X) -> X. g(Y) -> X." 1 "unbound variable X")
