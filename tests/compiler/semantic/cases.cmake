# Forward/remote calls resolve across positional files in one batch.
semantic_case(nested_local "-module(a). f() -> id(id(42)). id(X) -> X." 0 "^$")
semantic_case(forward_call "-module(a). f(X) -> g(X). g(Y) -> Y." 0 "^$")
