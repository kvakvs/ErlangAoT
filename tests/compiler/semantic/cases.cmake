# Run declaration checks through the default compiler action; syntax-only modes stay broader.
set(semantic_work "${WORK}/semantics")
file(MAKE_DIRECTORY "${semantic_work}")
function(semantic_case name source status pattern)
    file(WRITE "${semantic_work}/${name}.erl" "${source}")
    execute_process(COMMAND "${TOOL}" "${name}.erl" WORKING_DIRECTORY "${semantic_work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 15)
    if(NOT result STREQUAL "${status}" OR NOT out STREQUAL "" OR NOT err MATCHES "${pattern}")
        message(FATAL_ERROR "Semantic ${name}: ${result}: ${out}${err}")
    endif()
    if(EXISTS "${semantic_work}/a.out")
        message(FATAL_ERROR "Semantic analysis published an artifact")
    endif()
endfunction()
semantic_case(missing "f() -> 42." 1 "missing.erl:1:1.*missing module")
semantic_case(empty "" 1 "empty.erl:1:1.*missing module")
semantic_case(duplicate_module "-module(a). -module(b)." 1 "duplicate module")
semantic_case(duplicate_function "-module(a). f() -> 1. g() -> 2. f() -> 3." 1 "duplicate function f/0")
semantic_case(undefined_export "-module(a). -export([f/1]). f() -> 1." 1 "undefined function f/1")
semantic_case(duplicate_export "-module(a). -export([f/0,f/0]). f() -> 1." 1 "duplicate export f/0")
semantic_case(huge_export "-module(a). -export([f/99999999999999999999999])." 1 "arity must be in 0..255")
semantic_case(negative_export "-module(a). -export([f/-1])." 1 "negative_export.erl:1:28: bad attribute value")
semantic_case(unicode "-module('λ_mod'). -export(['quoted name'/0]). 'quoted name'() -> 42." 0 "^$")
semantic_case(overloads "-module(a). -export([f/0,f/1]). f() -> 1. f(X) -> X." 0 "^$")
execute_process(COMMAND "${TOOL}" --parse-check missing.erl WORKING_DIRECTORY "${semantic_work}"
    RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Syntax-only action performed semantic validation")
endif()
execute_process(COMMAND "${TOOL}" missing.erl undefined_export.erl WORKING_DIRECTORY "${semantic_work}"
    RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "1" OR NOT err MATCHES "missing module.*undefined function")
    message(FATAL_ERROR "Semantic failure prevented later-file diagnostics: ${err}")
endif()
semantic_case(empty_module "-module(''). f() -> 1." 1 "invalid module name")
set(parameters "")
foreach(index RANGE 0 255)
    if(index GREATER 0)
        string(APPEND parameters ",")
    endif()
    string(APPEND parameters "V${index}")
endforeach()
semantic_case(large_function "-module(a). f(${parameters}) -> 1." 1 "function arity exceeds 255")
